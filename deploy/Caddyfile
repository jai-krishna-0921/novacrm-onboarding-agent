{$DOMAIN} {
	encode gzip

	# Request log with secrets removed (the Gmail push token travels in the query string).
	log {
		output stdout
		format filter {
			request>uri query {
				replace token REDACTED
			}
			request>headers>Authorization delete
			request>headers>X-Retell-Signature delete
		}
	}

	# Public: webhooks verify their own credentials (Retell HMAC signature, Gmail push token).
	@public path /webhooks/* /healthz
	handle @public {
		reverse_proxy api:8000
	}

	# Everything else (runs, escalations, resolve, admin) needs the admin password.
	handle {
		basic_auth {
			admin {$ADMIN_PASSWORD_HASH}
		}
		reverse_proxy api:8000
	}
}
