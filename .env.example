# ---- Core ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app
MIG_SOURCE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mig_source
MIG_DEST_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mig_dest
PUBLIC_BASE_URL=https://<your-subdomain>.ngrok-free.app
PROVIDER_MODE=fake                 # fake | real
LOG_LEVEL=INFO

# ---- Dashboard login (app/auth.py) ----
# admin/admin is the demo account while we build. CHANGE BOTH before sharing the URL with anyone.
# Empty ADMIN_PASSWORD = the dashboard and API refuse every request (503); they never fall open.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SESSION_SECRET=                    # random string; empty = new one per restart (everyone signs in again)

# ---- Call policy (demo-friendly defaults; plan says 15 min in production) ----
CALL_MAX_ATTEMPTS=3
CALL_RETRY_DELAY_SECONDS=30
# Agent 3 (project tracking): seconds between scheduled Rocketlane syncs (POST /runs/{id}/sync is on demand)
TRACKING_INTERVAL_SECONDS=600
STUCK_RUN_MINUTES=10

# ---- LLM (Anthropic) ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_JUDGE_MODEL=claude-haiku-5-5   # Sonnet 5.5 is opt-in (20x the price)
LLM_HANDOFF_MODEL=claude-sonnet-5-5

# ---- Gmail + Pub/Sub ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/gmail-deals
GMAIL_PUSH_TOKEN=                  # random string you generate
CS_INBOX_ADDRESS=

# ---- Retell AI ----
RETELL_API_KEY=                    # the key with the webhook badge (used to verify signatures)
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=                # the number you BUY in Retell (caller ID), E.164, e.g. +14155550123 — NOT your phone

# ---- Demo AE (seeded into the AE directory; this is who gets called) ----
DEMO_AE_NAME=
DEMO_AE_EMAIL=                     # the address you send deal emails FROM
DEMO_AE_PHONE=                     # your mobile, E.164, e.g. +9198XXXXXXXX

# ---- Rocketlane ----
ROCKETLANE_API_KEY=
ROCKETLANE_BASE_URL=https://api.rocketlane.com/api/1.0
ROCKETLANE_TEMPLATE_ENTERPRISE=
ROCKETLANE_TEMPLATE_GROWTH=
ROCKETLANE_OWNER_EMAIL=
ROCKETLANE_PM_EMAIL=
ROCKETLANE_CSM_ENTERPRISE=         # dedicated CSM email
ROCKETLANE_CSM_GROWTH=             # pooled CSM email
ROCKETLANE_APP_URL=                # e.g. https://<subdomain>.rocketlane.com (dashboard project links)

# ---- Slack ----
SLACK_BOT_TOKEN=xoxb-...
SLACK_INTERNAL_MEMBER_IDS=         # comma-separated user IDs added to every channel
