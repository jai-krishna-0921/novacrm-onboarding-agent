{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./backend/.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(git add .env)",
      "Bash(git add -f .env)"
    ],
    "allow": [
      "Read(./.env.example)",
      "Edit(./.env.example)",
      "Bash(awk -F= '/^[A-Za-z_]/{print $1, ($2 ~ /^[[:space:]]*(#.*)?$/ ? \"EMPTY\" : \"set\")}' .env)"
    ]
  }
}
